{namespace com.liferay.change.tracking.change.lists.web.ChangeListManagementBar}

/**
 * Renders the Overview screen
 */
{template .render}
	{@param spritemap: string}
	{@param? urlCreateChangeList: string}
	{@param? urlCollections: string}
	{@param? _handleClearResultsClick: any}
	{@param? _handleFilterDoneButtonClick: any}
	{@param? _handleFilterListItemClicked: any}
	{@param? _handleOnFiltersSubmit: any}
	{@param? _handleOnFormSubmit: any}
	{@param? _handleOrderItemClicked: any}
	{@param? _handleShowFiltersBar: any}
	{@param? _handleSearchSearchClick: any}
	{@param? _handleSortingButtonClicked: any}
	{@param? totalItems: number}
	{@param? orders: list<?>}
	{@param? filterDropdownList: list<?>}
	{@param? searchResults: list<[
		title: string,
		conflict: bool,
		userName: string,
		site: string,
		contentType: string,
		lastEdited: string,
		changeType: string,
		version: string
	]>}
	{@param? searchValue: string}
	{@param? showRestFiltersBar: bool}
	{@param? sortingOrder: string}
	{@param? cardStateColor: string}
	{@param? headerSubTitle: any}
	<div class="overview-card-sheet {$cardStateColor}">
		<div class="overview-card-container overview-card-header">
			<div class="row">
				<div class="col-sm-12">
					{if $headerSubTitle}
						<h3 data-qa-id="headerSubTitle">{$headerSubTitle}</h3>
					{/if}
				</div>
			</div>
		</div>
		{call com.liferay.change.tracking.change.lists.web.RestManagementToolbar.render}
			{param spritemap: $spritemap /}
			{param _handleFilterDoneButtonClick: $_handleFilterDoneButtonClick /}
			{param events: [
				'filterListItemClicked': $_handleFilterListItemClicked,
				'search': $_handleSearchSearchClick,
				'searchSubmit': $_handleOnFormSubmit,
				'sortingButtonClicked': $_handleSortingButtonClicked,
				'onFiltersSubmited': $_handleOnFiltersSubmit,
				'orderItemClicked': $_handleOrderItemClicked,
				'clearButtonClicked': $_handleClearResultsClick,
			] /}
			{param _handleShowFiltersBar: $_handleShowFiltersBar /}
			{param orderItems: $orders/}
			{param filterDropdownList: $filterDropdownList /}
			{param searchActionURL: $urlCreateChangeList /}
			{param searchFormMethod: 'GET' /}
			{param searchFormName: 'mySearchForm' /}
			{param searchValue: $searchValue /}
			{param showCreationMenu: false /}
			{param showRestFiltersBar: $showRestFiltersBar /}
			{param showSearch: true /}
			{param sortingOrder: $sortingOrder /}
			{param totalItems: $totalItems /}
		{/call}

		{if $searchResults}
			{if length($searchResults) == 0}
				<div class="card-sheet-divider"></div>
				<div class="sheet taglib-empty-result-message">
					<div class="taglib-empty-result-message-header"></div>
					<div class="sheet-text text-center">
						{msg desc=""}
							there-are-no-changes-in-this-change-list{/msg}
					</div>
				</div>
			{else}
				<div class="card-sheet-divider"></div>
				<div class="table-responsive">
					<table class="table">
						<thead>
						<tr>
							<th class="table-cell-expand">{msg desc=""}
								title{/msg}</th>
							<th class="table-cell-expand">{msg desc=""}
								conflict{/msg}</th>
							<th class="table-cell-expand">{msg desc=""}
								user-name{/msg}</th>
							<th class="table-cell-expand">{msg desc=""}
								site{/msg}</th>
							<th class="table-cell-expand">{msg desc=""}
								content-type{/msg}</th>
							<th class="table-cell-expand">{msg desc=""}
								last-edited{/msg}</th>
							<th class="table-cell-expand">{msg desc=""}
								change-type{/msg}</th>
							<th class="table-cell-expand">{msg desc=""}
								version{/msg}</th>
						</tr>
						</thead>

						<tbody>
							{foreach $changeEntry in $searchResults}
								{call .changeEntry}
									{param changeType: $changeEntry.changeType /}
									{param conflict: $changeEntry.conflict /}
									{param contentType: $changeEntry.contentType /}
									{param index: index($changeEntry) /}
									{param lastEdited: $changeEntry.lastEdited /}
									{param site: $changeEntry.site /}
									{param title: $changeEntry.title /}
									{param userName: $changeEntry.userName /}
									{param version: $changeEntry.version /}
								{/call}
							{/foreach}
						</tbody>
					</table>
				</div>
			{/if}
		{else}
			<div class="sheet-text text-center text-strong empty-production-view">
				{msg desc=""}no-change-list-has-been-published-yet{/msg}
			</div>
		{/if}
		<div class="card-sheet-divider"></div>
		{call PaginationBar.render}
		{/call}
		<input type="hidden" value="{$urlCollections}"/>
	</div>
{/template}

{template .changeEntry}
	{@param changeType: string}
	{@param conflict: bool}
	{@param contentType: string}
	{@param index: number}
	{@param lastEdited: string}
	{@param site: string}
	{@param title: string}
	{@param userName: string}
	{@param version: string}

	<tr>
		<td class="table-cell-expand">
			<div id="change-entry-title-{$index}">{$title}</div>
		</td>
		<td class="table-cell-expand">
			<div id="change-entry-conflict-{$index}">
			{if $conflict}
				{msg desc=""}yes{/msg}
			{else}
				{msg desc=""}no{/msg}
			{/if}
			</div>
		</td>
		<td class="table-cell-expand">
			<div id="change-entry-user-name-{$index}">{$userName}</div>
		</td>
		<td class="table-cell-expand">
			<div id="change-entry-site-{$index}">{$site}</div>
		</td>
		<td class="table-cell-expand">
			<div id="change-entry-content-type-{$index}">{$contentType}</div>
		</td>
		<td class="table-cell-expand">
			<div id="change-entry-last-edited-{$index}">{$lastEdited}</div>
		</td>
		<td class="table-cell-expand">
			<div id="change-entry-change-type-{$index}">{$changeType}</div>
		</td>
		<td class="table-cell-expand">
			<div id="change-entry-version-{$index}">{$version}</div>
		</td>
	</tr>
{/template}